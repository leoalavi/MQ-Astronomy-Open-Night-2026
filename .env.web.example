# Web build environment for Astronomy Open Night 2026.
#
# Use with:  flutter build web --release --dart-define-from-file=.env.web \
#              --base-href / --no-web-resources-cdn
#
# The web bundle (main.dart.js) embeds every value read via
# String.fromEnvironment. The web-specific conditional import reads only
# MAPS_API_KEY, so native route-key defines cannot enter the web compilation
# unit. Copy this file to .env.web and fill the web key only. .env.web is
# git-ignored; never commit real keys.

APP_ENV=production

# Web Maps JavaScript API key. Public by nature (ships in main.dart.js) — it
# MUST be restricted to Maps JavaScript API and Routes API, with both allowed
# HTTP referrers:
#   https://aon.syllabus-sync.app/*
#   https://aon.syllabus-sync.app/
MAPS_API_KEY=
