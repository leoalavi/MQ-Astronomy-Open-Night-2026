# Minimum deployment target. Raised 14.0 -> 15.0 for Flutter 3.47.1, whose tooling
# declares iOS 15.0 as its minimum supported version (flutter_tools
# darwin.dart: `ios => Version(15, 0, null)`); builds on 3.47.1 rewrite this line
# automatically otherwise. No plugin needs more than 13.0 — google_maps_flutter_ios
# declares none, shared_preferences_foundation is the highest at 13.0 — so the SDK
# is the sole driver here.
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

# Keep ios/Flutter/Secrets.xcconfig in step with the project-root .env, so the
# native Google Maps key reaches Info.plist's GMSApiKey even when the app is
# launched from Xcode or with a plain `flutter run` (no --dart-define-from-file).
# Both files are git-ignored; the script never logs the key value.
require 'fileutils'
require File.expand_path(File.join('..', 'tool', 'sync_ios_secrets'), __dir__)
Pod::UI.puts "[aon] #{AonSecrets.sync(File.expand_path('..', __dir__))}"

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # geolocator: We only use When-In-Use — exclude the Always-location code so
      # App Store review doesn't ask about background location (Map Parity Phase A).
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'BYPASS_PERMISSION_LOCATION_ALWAYS=1',
      ]
      # Keep every pod on the SAME minimum as the app (see `platform` at the top).
      # This line overrides whatever flutter_additional_ios_build_settings set, so
      # leaving it at 14.0 would build the pods one OS below the app itself.
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
