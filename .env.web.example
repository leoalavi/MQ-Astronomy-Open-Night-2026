# Web build environment for Astronomy Open Night 2026.
#
# Use with:  flutter build web --release --dart-define-from-file=.env.web \
#              --base-href /astronomy-open-night/app/
#
# The web bundle (main.dart.js) embeds every value read via
# String.fromEnvironment. lib/services/maps_nav_providers.dart reads the
# Android, iOS and web Routes keys — so the NATIVE keys are left EMPTY here on
# purpose, to keep them out of the web JS. Copy to .env.web and fill the web
# key(s) only. .env.web is git-ignored; never commit real keys.

APP_ENV=production

# Web Maps JavaScript API key. Public by nature (ships in main.dart.js) — it
# MUST carry an HTTP-referrer restriction to https://info.syllabus-sync.app/*.
MAPS_API_KEY=

# Optional dedicated web Routes key (same referrer restriction). If empty,
# MAPS_API_KEY is used for the Routes API on web too.
GOOGLE_MAPS_WEB_ROUTES_KEY=

# Native keys — leave EMPTY for web builds so they never enter the bundle.
GOOGLE_MAPS_ANDROID_ROUTES_KEY=
GOOGLE_MAPS_IOS_ROUTES_KEY=
